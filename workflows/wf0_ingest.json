    {
      "id": "e90fea41-80c6-436a-a9d7-3ebc4fb3220e",
      "name": "Normalize GitHub Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// GitHub webhook payload is normally inside \"body\"\nconst payload = input.body ?? input;\n\nconst run = payload.workflow_run ?? {};\nconst repo = payload.repository ?? {};\n\n// We only want completed workflow runs\nif (payload.action && payload.action !== 'completed') {\n  return [];\n}\n\nreturn [\n  {\n    json: {\n      action: payload.action ?? 'completed',\n\n      run_id: run.id,\n      run_number: run.run_number,\n\n      workflow_name: run.name,\n      workflow_path: run.path,\n\n      status: run.status,\n      conclusion: run.conclusion,\n\n      head_sha: run.head_sha,\n      branch: run.head_branch,\n\n      repository: repo.full_name,\n      repository_owner: repo.owner?.login ?? '',\n      repository_name: repo.name ?? '',\n\n      html_url: run.html_url,\n\n      created_at: run.created_at,\n      updated_at: run.updated_at,\n\n      sender: payload.sender?.login ?? ''\n    }\n  }\n];"
      }
    },
    {
      "id": "46f7901a-fc1a-4964-bb22-2a4ad87d2acf",
      "name": "Fetch Artifacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "url": "=https://api.github.com/repos/adithyashetty39-lang/stormbreakers-demo/actions/runs/{{ $json.run_id }}/artifacts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "KmkmjtyH6wK2g6pW",
          "name": "GitHub Hackathon PAT"
        }
      }
    },
    {
      "id": "a07e51c7-02e7-4d1f-b220-d4314c5e7835",
      "name": "Extract Artifacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nconst artifacts = response.artifacts || [];\n\nreturn artifacts.map(artifact => ({\n  json: {\n    artifact_id: artifact.id,\n    artifact_name: artifact.name,\n    artifact_size: artifact.size_in_bytes,\n    archive_download_url: artifact.archive_download_url,\n    expired: artifact.expired,\n    created_at: artifact.created_at\n  }\n}));"
      }
    },
    {
