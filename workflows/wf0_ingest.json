    {
      "id": "700c2bb6-0d0f-4f51-97f9-5b5cfa96d48c",
      "name": "Inspect Artifact Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1536,
        176
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.flatMap((item, index) => {\n  const binary = item.binary || {};\n\n  return Object.entries(binary).map(([key, file]) => ({\n    json: {\n      item_index: index,\n      binary_key: key,\n      file_name: file.fileName || '',\n      mime_type: file.mimeType || '',\n      file_size: file.fileSize || ''\n    }\n  }));\n});"
      }
    },
    {
      "id": "8bb615c0-2979-44c7-953a-ccb686ed5e11",
      "name": "Split XML Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        -96
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary || {};\n\nreturn Object.entries(binary).map(([key, file]) => ({\n  json: {\n    file_name: file.fileName || key\n  },\n  binary: {\n    data: file\n  }\n}));"
      }
    },
    {
      "id": "a4e5e24e-f707-4ddd-9bf3-01dd6252edf9",
      "name": "Extract from File",
