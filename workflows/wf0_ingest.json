    {
      "id": "82efc158-c773-47d6-b701-12a7f1de695d",
      "name": "Parse Test Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        -96
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet coverageXml = null;\nlet junitXml = null;\n\nfor (const item of items) {\n  const xml = item.json.xml;\n\n  if (!xml) continue;\n\n  const text = xml.trim();\n\n  if (text.includes('<coverage ')) {\n    coverageXml = xml;\n  } else if (\n    text.includes('<testsuite') ||\n    text.includes('<testsuites')\n  ) {\n    junitXml = xml;\n  }\n}\n\nreturn [\n  {\n    json: {\n      coverage_xml: coverageXml,\n      junit_xml: junitXml,\n      coverage_file: coverageXml ? 'coverage.xml' : null,\n      junit_file: junitXml ? 'junit.xml' : null,\n    },\n  },\n];"
      }
    },
    {
      "id": "8c2f2db8-c108-4d2f-ba1f-13e69b16cc70",
      "name": "Prepare Analysis Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        -96
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nreturn [\n  {\n    json: {\n      repository: 'adithyashetty39-lang/stormbreakers-demo',\n\n      workflow_run: {\n        run_id: $('Normalize GitHub Event').first().json.run_id,\n        run_number: $('Normalize GitHub Event').first().json.run_number,\n        workflow_name: $('Normalize GitHub Event').first().json.workflow_name,\n        head_sha: $('Normalize GitHub Event').first().json.head_sha,\n        branch: $('Normalize GitHub Event').first().json.branch,\n        conclusion: $('Normalize GitHub Event').first().json.conclusion,\n        html_url: $('Normalize GitHub Event').first().json.html_url\n      },\n\n      test_results: {\n        junit_xml: input.junit_xml,\n        coverage_xml: input.coverage_xml\n      },\n\n      evidence: {\n        junit_available: !!input.junit_xml,\n        coverage_available: !!input.coverage_xml\n      }\n    }\n  }\n];"
      }
    },
