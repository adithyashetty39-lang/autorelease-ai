    },
    {
      "id": "find-artifact-1",
      "name": "Find Test Results Artifact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const responses = $input.all();\nconst originals = $('Extract Run List').all();\nreturn responses.map((item, i) => {\n  const artifacts = item.json.artifacts || [];\n  const testArtifact = artifacts.find((a) => a.name === 'test-results');\n  const orig = originals[i] ? originals[i].json : {};\n  return {\n    json: {\n      run_id: orig.run_id,\n      run_number: orig.run_number,\n      head_sha: orig.head_sha,\n      conclusion: orig.conclusion,\n      archive_download_url: testArtifact ? testArtifact.archive_download_url : '',\n    },\n  };\n});"
      }
    },
    {
      "id": "has-artifact-if-1",
      "name": "Has Artifact",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1320,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
