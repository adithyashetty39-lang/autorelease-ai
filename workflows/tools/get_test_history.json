    {
      "id": "extract-run-list-1",
      "name": "Extract Run List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const runs = ($input.first().json.workflow_runs || []).filter((r) => r.name === 'CI').slice(0, 10);\nreturn runs.map((r) => ({ json: { run_id: r.id, run_number: r.run_number, head_sha: r.head_sha, conclusion: r.conclusion } }));"
      }
    },
    {
      "id": "fetch-artifacts-1",
      "name": "Fetch Artifacts For Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        880,
        100
      ],
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Normalize Input').first().json.repo }}/actions/runs/{{ $json.run_id }}/artifacts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "KmkmjtyH6wK2g6pW",
          "name": "GitHub Hackathon PAT"
        }
