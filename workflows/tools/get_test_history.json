      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nconst input = raw.body ?? raw; // handle both the tool trigger (direct) and the test webhook (wrapped)\nreturn [{ json: { test_name: input.test_name || '', repo: input.repo || 'adithyashetty39-lang/stormbreakers-demo', branch: input.branch || 'main' } }];"
      }
    },
    {
