      ],
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/actions/runs?branch={{ $json.branch }}&status=completed&per_page=20",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
