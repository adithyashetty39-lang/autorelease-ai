      "typeVersion": 1.1,
      "position": [
        1760,
        -40
      ],
      "parameters": {}
    },
    {
      "id": "split-binary-1",
      "name": "Split Binary Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -40
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (const item of items) {\n  const binary = item.binary || {};\n  for (const [key, file] of Object.entries(binary)) {\n    out.push({\n      json: {\n        run_id: item.json.run_id,\n        run_number: item.json.run_number,\n        head_sha: item.json.head_sha,\n        conclusion: item.json.conclusion,\n        file_name: file.fileName || key,\n      },\n      binary: { data: file },\n    });\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "extract-file-1",
      "name": "Extract from File",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        2200,
        -40
      ],
      "parameters": {
        "operation": "xml",
        "destinationKey": "xml",
        "options": {},
        "binaryPropertyName": "data"
      }
    },
    {
      "id": "check-test-1",
      "name": "Check Test In Junit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        -40
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const testName = $('Normalize Input').first().json.test_name || '';\nconst shortName = testName.includes('.') ? testName.split('.').pop() : testName;\nconst items = $input.all();\nconst originals = $('Split Binary Files').all(); // Extract from File drops non-xml json fields -- recover context by index\nconst results = [];\nitems.forEach((item, i) => {\n  const xml = item.json.xml || '';\n  if (!xml.includes('<testsuite')) return; // skip coverage.xml, only want junit\n  if (!shortName) return;\n  const orig = originals[i] ? originals[i].json : {};\n  const marker = 'name=\"' + shortName + '\"';\n  const idx = xml.indexOf(marker);\n  let status = 'not_found';\n  if (idx !== -1) {\n    const selfCloseIdx = xml.indexOf('/>', idx);\n    const closeTagIdx = xml.indexOf('</testcase>', idx);\n    let blockEnd;\n    if (selfCloseIdx !== -1 && (closeTagIdx === -1 || selfCloseIdx < closeTagIdx)) blockEnd = selfCloseIdx;\n    else blockEnd = closeTagIdx !== -1 ? closeTagIdx : xml.length;\n    const block = xml.slice(idx, blockEnd);\n    status = (block.includes('<failure') || block.includes('<error')) ? 'fail' : 'pass';\n  }\n  results.push({ json: { run_id: orig.run_id, run_number: orig.run_number, head_sha: orig.head_sha, conclusion: orig.conclusion, status } });\n});\nreturn results;"
      }
    },
    {
      "id": "mark-no-data-1",
      "name": "Mark No Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item) => ({\n  json: { run_id: item.json.run_id, run_number: item.json.run_number, head_sha: item.json.head_sha, conclusion: item.json.conclusion, status: 'no_test_artifact' },\n}));"
      }
    },
    {
      "id": "aggregate-1",
      "name": "Aggregate History",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2660,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst testName = $('Normalize Input').first().json.test_name || '';\nconst history = items.map((i) => i.json).sort((a, b) => (b.run_number || 0) - (a.run_number || 0));\nconst passCount = history.filter((h) => h.status === 'pass').length;\nconst failCount = history.filter((h) => h.status === 'fail').length;\nconst unknownCount = history.filter((h) => h.status === 'not_found' || h.status === 'no_test_artifact').length;\nreturn [{\n  json: {\n    test_name: testName,\n    runs_checked: history.length,\n    pass_count: passCount,\n    fail_count: failCount,\n    unknown_count: unknownCount,\n    history,\n  },\n}];"
      }
    }
