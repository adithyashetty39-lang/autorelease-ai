# Copy to .env and fill in. Never commit the real .env.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
TZ=Asia/Kolkata

# These are used INSIDE n8n (set as n8n credentials, not container env vars,
# for anything AI Agent nodes touch) -- listed here so the team has one
# place to see what needs to exist before Phase 2:
#   GITHUB_PAT=            # fine-grained: actions:read, contents:read,
#                           # pull_requests:read, statuses:write,
#                           # security_events:read, workflows:write
#   GEMINI_API_KEY=
#   GEMINI_API_KEY_FALLBACK=   # second key/project, see Phase 0 rate-limit note
#   SLACK_WEBHOOK_URL=
#   GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=   # path or paste via n8n credential UI
